{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run EE Job Alert",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "-n",
        "jobrobot",
        "python",
        "-m",
        "src.main"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "-n",
        "jobrobot",
        "pytest"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
